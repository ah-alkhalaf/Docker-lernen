# Optional. Copy to .env:  cp .env.example .env
# Leave a password empty to get a random one printed in the logs:
#   make passwords
BOX1_PASSWORD=
BOX2_PASSWORD=
BOX3_PASSWORD=
BOX4_PASSWORD=
# Optional SSH public keys (the content of id_ed25519.pub)
BOX1_PUBLIC_KEY=
BOX2_PUBLIC_KEY=
BOX3_PUBLIC_KEY=
BOX4_PUBLIC_KEY=
# 0.0.0.0 = reachable from your LAN, 127.0.0.1 = only from this machine
BIND_ADDR=0.0.0.0
